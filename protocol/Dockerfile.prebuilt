# ZEC SSL coordinator and operator from binaries built elsewhere (deploy/push-binaries.sh),
# for servers too small to compile the Zcash libraries. The binaries must be built on the
# same architecture and an Ubuntu 24.04 (glibc 2.39) system, which is why the base matches.
# Build context: the protocol/ directory, with the binaries in protocol/bin/.

FROM ubuntu:24.04
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY bin/ssl-coordinator bin/ssl-operator /usr/local/bin/

ENV STATE_DIR=/var/data \
    RUST_LOG=info
VOLUME ["/var/data"]
CMD ["ssl-operator"]
