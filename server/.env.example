# HTTP
PORT=4000
HOST=0.0.0.0
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Public data sources (no keys needed; keys raise rate limits)
COINGECKO_API_KEY=
BLOCKCHAIR_API_KEY=

# Zcash chain access. Point this at your Zebra node (JSON-RPC) for full data, including
# shielded pool sizes. Without it the server falls back to Blockchair, then 3xpl.
ZEBRA_RPC_URL=
# user:password if the RPC endpoint needs basic auth
ZEBRA_RPC_AUTH=

# NEAR network the vault and bond contracts live on (testnet for the Zecathon MVP)
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# ZEC SSL contracts on NEAR (leave empty until deployed)
NEAR_VAULT_CONTRACT=
NEAR_BONDS_CONTRACT=

# ZEC SSL coordinator (orders, signing rounds, treasury). Leave empty until running.
COORDINATOR_URL=
# Operator nodes as name=url pairs, comma separated, e.g. op-1=http://10.0.0.1:7000
OPERATOR_ENDPOINTS=
# Signing threshold t-of-n
THRESHOLD_T=2
THRESHOLD_N=3

# Quotes
# Operator spread in basis points added to each quote
QUOTE_SPREAD_BPS=25
# Any valid transparent Zcash address, used only to validate dry-run router quotes
# against NEAR Intents 1Click. No funds are ever sent to it. Without it, quotes are
# priced from the live 1Click oracle feed instead.
INTENTS_REFERENCE_REFUND=

# Testnet faucet (registers accounts with the vault token and sends test USDC).
# Either an account and its secret key (use these on Render), or a NEAR CLI credentials file.
NEAR_FAUCET_ACCOUNT=
NEAR_FAUCET_KEY=
NEAR_FAUCET_CREDENTIALS=
# Set to true behind a proxy (Render) so rate limits see real client addresses.
TRUST_PROXY=false
